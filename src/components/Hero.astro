---
import type { Translations, Locale } from '../i18n';
import { contactInfo } from '../config/contact';
import { Image } from "astro:assets";
import profile from "../assets/img/profile/profile.webp";
interface Props {
    t: Translations["hero"];
    locale: Locale;
}

const { t, locale } = Astro.props;
---

<section class="hero-container">
    <div class="row align-items-center w-100 m-0">
        <div class="col-md-6 hero-text-block p-1 p-md-2">
            <span class="badge-status">{t.badge}</span>
            <h1 class="hero-title">{t.greeting} <span>{t.name}</span></h1>
            <h2 class="hero-subtitle">{t.role}</h2>

            <div class="hero-photo-mobile">
                <Image
                    src={profile}
                    alt="Eduardo Davila"
                    class="hero-photo"
                />
            </div>

            <p class="hero-description">{t.description}</p>

            <div class="hero-social py-2">
                <a href={contactInfo.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <i class="fa-brands fa-linkedin-in"></i>
                </a>
                <a href={contactInfo.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                    <i class="fa-brands fa-github"></i>
                </a>
                <a href={`mailto:${contactInfo.email}`} aria-label={t.email}>
                    <i class="fa-solid fa-envelope"></i>
                </a>
                <a href={contactInfo.cvUrl[locale]} download class="btn btn-contact btn-sm">
                    <i class="fa-solid fa-file-arrow-down"></i>
                    {t.downloadCv}
                </a>
            </div>
        </div>

        <div class="col-md-6 hero-canvas-block p-2">
            <div class="glass-canvas">
                <div id="logo-particles">
                    <img src="/icons/code.svg" alt="" />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    #logo-particles img {
        display: none !important;
    }

    .hero-container {
        display: flex;
        align-items: center;
        padding: 1rem 0;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        color: var(--id-text-primary);
        margin-bottom: 1rem;
    }

    .hero-title span {
        color: var(--id-color-brand);
    }

    .hero-subtitle {
        font-size: 1.5rem;
        color: var(--id-text-secondary);
        margin-bottom: 1.5rem;
        font-weight: 500;
    }

    .hero-description {
        font-size: 1rem;
        color: var(--id-text-secondary);
        line-height: 1.7;
    }

    .hero-canvas-block {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        height: 400px;

        @media (max-width: 767.98px) {
            display: none;
        }
    }

    .glass-canvas {
        width: 100%;
        height: 100%;
        background: var(--id-bg-superficie);
        border: 1px solid var(--id-border-color);
        border-radius: 16px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        position: relative;
        overflow: hidden;
    }

    #logo-particles {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
    }

    .hero-social {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .hero-social a:not(:last-child) {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 8px;
        border: 1px solid var(--id-border-color);
        color: var(--id-color-brand);
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .hero-social a:not(:last-child):hover {
        background: var(--id-hover-brand-bg);
        border-color: var(--id-color-brand);
        transform: translateY(-2px);
    }

    .hero-photo-mobile {
        display: none;
    }

    @media (max-width: 767.98px) {
        .hero-photo-mobile {
            display: flex;
            justify-content: center;
            margin: 1.25rem 0;
        }

        .hero-photo-mobile img {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--id-color-brand);
            box-shadow: 0 10px 30px rgba(0,0,0,.15);
        }
    }
</style>
